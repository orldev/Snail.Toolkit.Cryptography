<Project Sdk="Snail.Sdk.Library">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>Snail.Toolkit.Cryptography</PackageId>
        <PackageTags>System.Security.Cryptography</PackageTags>
        <Title>Snail.Toolkit.Cryptography</Title>
        <Authors>orldev</Authors>
        <Description>Authenticated symmetric encryption (AES-GCM) with PBKDF2 key derivation for .NET. Exposes ISymmetricCipher over byte arrays, Base64 strings and the caller's own buffers, configured through IOptions and registered with a single AddSymmetricCipher call.</Description>
        <Copyright>orldev, 2023–2026</Copyright>
        <RepositoryUrl>https://github.com/orldev/Snail.Toolkit.Cryptography</RepositoryUrl>
        <PackageProjectUrl>https://github.com/orldev/Snail.Toolkit.Cryptography</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <!--
      Settings are bound by the configuration binding source generator, not by reflection: in a native app the
      reflection binder binds nothing, and AddSymmetricCipher(configuration) failed at its first resolve.
    -->
    <PropertyGroup>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    </PropertyGroup>
    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Configuration" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    </ItemGroup>

</Project>
